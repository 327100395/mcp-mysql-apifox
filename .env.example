# 请优先让 AI 调用 config 工具，或执行：npx -y mcp-mysql-apifox config <projectRoot>
# 初始化页面支持多个命名数据库和 FTP 配置，并生成加密的 .env.mma。
# 本文件仅保留旧版单套 dotenv 格式兼容示例。

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=

APIFOX_API_KEY=
APIFOX_PROJECT_ID=

FTP_HOST=
FTP_PORT=
FTP_PROTOCOL=ftp
FTP_USERNAME=
FTP_PASSWORD=
FTP_PRIVATE_KEY_PATH=
FTP_PASSPHRASE=
